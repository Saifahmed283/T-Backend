# Copy to .env and fill in. Never commit the filled-in file.

# Runtime role. Least privilege: the API can read its own tables, manage
# sessions, and update only the columns it writes.
# Create the login role with DIRECT_URL, then apply the grants with the script
# (both are idempotent; the grants script also clears blanket defaults):
#   npm run db:roles            # needs DB_APP_PASSWORD below
#   npm run prisma:deploy
#   npm run db:privileges
#   npm run db:privileges -- terramorph_test   # after the test DB exists
# Verify with: npm run db:privileges:inspect
# Do not hand-write broad GRANTs here; the script encodes what the queries need.
DATABASE_URL="postgresql://terramorph_app:CHANGE_ME@ep-example-pooler.region.aws.neon.tech/terramorph-backend?sslmode=require"
DB_APP_PASSWORD=CHANGE_ME

# Migration role. Needs DDL, so it must be an owner. Used only by `prisma migrate`.
DIRECT_URL="postgresql://terramorph-backend_owner:CHANGE_ME@ep-example-pooler.region.aws.neon.tech/terramorph-backend?sslmode=require"
# Role that owns the tables; read by the privileges script (ALTER DEFAULT
# PRIVILEGES). Must match the role DIRECT_URL authenticates as (the owner role).
DB_OWNER_ROLE=terramorph-backend_owner

# Port the API listens on. Hostinger injects its own PORT; leave this as a
# local-dev fallback and let the platform override it in production.
PORT=4000
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call the API. In production
# this is the deployed site, e.g. https://askterramorph.com
# The site and API are on different domains, so the session cookie uses
# SameSite=None; Secure (see COOKIE_SAMESITE below) and CSRF is enforced by an
# Origin check on every state-changing request.
FRONTEND_ORIGIN=http://localhost:8443

# Signs the session HMAC. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME

# Absolute session lifetime, and an idle timeout that invalidates a session left
# unused. If SESSION_IDLE_HOURS is omitted it equals SESSION_TTL_HOURS.
SESSION_TTL_HOURS=336
# SESSION_IDLE_HOURS=72

# Session cookie SameSite. Defaults to 'none' in production (cross-site site +
# API) and 'lax' otherwise. SameSite=None requires HTTPS (Secure) in production.
# COOKIE_SAMESITE=none

# Trust X-Forwarded-* from the platform's reverse proxy so rate limiting keys on
# the real client IP. Defaults to true in production.
# TRUST_PROXY=true

# In-process scheduled publishing. Every API instance runs the tick; a Postgres
# advisory lock makes exactly one instance process each run, so several
# processes (or a rolling deploy) are safe. The 60s default matches the public
# site's polling window. Set SCHEDULER_ENABLED=false for one-off jobs that share
# the database with a live API.
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_MS=60000

# Outbound email. Off by default: submissions are still recorded and password
# resets still validate, but no mail leaves the process. Enable only after a
# provider is configured. `log` writes the message to the server log and
# `memory` is reserved for the test suite. Production must not use `memory`.
# EMAIL_ENABLED=false
# EMAIL_PROVIDER=log
# EMAIL_FROM="TerraMorph <notifications@askterramorph.com>"
# Where new public-site submissions are announced. When omitted, admin notices
# are skipped; receipts to submitters still send.
# ADMIN_NOTIFICATION_EMAIL=portal@askterramorph.com

# Password-reset links are single-use and expire after this many minutes.
# Only an HMAC digest of each token is stored.
# PASSWORD_RESET_TTL_MINUTES=30

# Login created by prisma/seed.ts. Change the password before any shared use.
SEED_ADMIN_EMAIL=portal@terramorph.local
SEED_ADMIN_PASSWORD=CHANGE_ME
# Optional distinct password for seeded lead accounts. Strongly recommended in
# production; when omitted leads reuse SEED_ADMIN_PASSWORD.
# SEED_LEAD_PASSWORD=CHANGE_ME

NODE_ENV=development
