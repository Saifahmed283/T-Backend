generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssignmentStatus {
  ON_TRACK
  AT_RISK
  BLOCKED
}
enum WorkflowStage {
  G0
  G1
  G2
  G3
  G4
  G5
  G6
  G7
}
enum ActivityType {
  CREATED
  STATUS_CHANGED
  STAGE_ADVANCED
  NOTE_ADDED
  ASSIGNED
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTENT_STATUS_CHANGED
  ASSET_UPLOADED
}

// The eleven publishable collections of the content workspace. One generic
// ContentItem table serves all of them: `kind` partitions the workspace and
// `data` holds the schema-driven field values.
enum ContentKind {
  ASSIGNMENT
  CASE
  PUBLICATION
  INSTRUMENT
  COURSE
  EXPERT
  PARTNER
  VACANCY
  INITIATIVE
  AUDIENCE
  STAGE
}

// Server-enforced editorial workflow. DRAFT -> REVIEW -> APPROVED -> PUBLISHED
// is the happy path; SCHEDULED covers timed publish, UNPUBLISHED and ARCHIVED
// are reversible exits.
enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}
enum ExpertStatus {
  REGISTERED
  PROFILE_COMPLETE
  VETTED
  MATCHED
  DEPLOYED
  REJECTED
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  passwordHash  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  memberships   WorkspaceMember[]
  ledAssignments Assignment[]     @relation("AssignmentLead")
  activities    ActivityLog[]
  sessions      Session[]
}

model Workspace {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  members      WorkspaceMember[]
  assignments  Assignment[]
  activities   ActivityLog[]
  experts      Expert[]
  contentItems ContentItem[]
  assets       Asset[]
  siteSetting  SiteSetting?
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        String    @default("member")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([workspaceId, userId])
  @@index([userId])
}

model Session {
  id               String   @id @default(cuid())
  tokenHash        String   @unique
  userId           String
  activeWorkspaceId String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Assignment {
  id          String           @id
  name        String
  client      String
  sector      String
  value       Int
  status      AssignmentStatus
  stage       WorkflowStage
  workspaceId String
  leadId      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        User             @relation("AssignmentLead", fields: [leadId], references: [id])
  activities  ActivityLog[]
  contentItems ContentItem[]
  @@index([workspaceId, status])
  @@index([workspaceId, stage])
  @@index([workspaceId, updatedAt])
}

model ActivityLog {
  id           String       @id @default(cuid())
  workspaceId  String
  type         ActivityType
  message      String
  assignmentId String?
  contentItemId String?
  userId       String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignment   Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  // SetNull rather than Cascade: the audit trail must outlive a hard delete.
  contentItem  ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([contentItemId, createdAt])
}

model Expert {
  id           String       @id @default(cuid())
  workspaceId  String
  name         String
  email        String       @unique
  sector       String
  country      String?
  status       ExpertStatus @default(REGISTERED)
  registeredAt DateTime     @default(now())
  vettedAt     DateTime?
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status])
}

enum SubmissionKind {
  CONTACT
  EXPERT_REGISTRATION
  SEAT_RESERVATION
  TENDER_INTEREST
  TEAM_PROPOSAL
  JOB_APPLICATION
  PUBLICATION_REQUEST
  NEWSLETTER
  CONTRIBUTION
}

enum SubmissionStatus {
  NEW
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// Inbound messages from the public marketing site (contact, registrations,
// reservations, tender/career interest, document requests). Platform-level, so
// it is deliberately not workspace-scoped: it is not tenant data.
model Submission {
  id        String           @id @default(cuid())
  kind      SubmissionKind
  status    SubmissionStatus @default(NEW)
  email     String?
  name      String?
  message   String?
  source    String?
  payload   Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@index([kind, createdAt])
  @@index([email])
  @@index([status, createdAt])
}

// One generic table for the eleven publishable collections. `title` is the
// denormalised English title so list/search queries stay indexable without
// reaching into the JSON payload; `data` holds the schema-driven field values
// as { [fieldKey]: { en?, ar? } }, matching the workspace editor.
model ContentItem {
  id                   String        @id @default(cuid())
  workspaceId          String
  kind                 ContentKind
  status               ContentStatus @default(DRAFT)
  slug                 String
  title                String
  data                 Json
  seo                  Json?
  // Optional link from a CMS assignment page back to the operational ledger row.
  assignmentId         String?
  sourceReference      String?
  scheduledPublishAt   DateTime?
  scheduledUnpublishAt DateTime?
  publishedAt          DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignment           Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  activities           ActivityLog[]
  @@unique([workspaceId, kind, slug])
  @@index([workspaceId, kind, status])
  @@index([workspaceId, status, updatedAt])
}

// Media library files. The bytes live in cloud storage (S3-compatible); this
// row is the catalogue: public URL, mime, size and bilingual alt text.
model Asset {
  id          String    @id @default(cuid())
  workspaceId String
  filename    String
  storageKey  String
  url         String
  mimeType    String
  size        Int
  alt         Json?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, mimeType])
}

// Per-workspace website configuration: contact/legal/social blocks, default SEO,
// homepage hero and navigation order. One JSON document, one row.
model SiteSetting {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  data        Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum NewsletterSubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

// Mailing-list opt-ins. Platform-level (not tenant data) and deliberately
// separate from Submission: it models double opt-in state and interests.
model NewsletterSubscriber {
  id          String                     @id @default(cuid())
  email       String                     @unique
  interests   Json?
  audience    String?
  locale      String                     @default("en")
  source      String?
  status      NewsletterSubscriberStatus @default(PENDING)
  confirmedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  @@index([status, createdAt])
}

// Readiness self-assessment question bank. Platform-level content.
model DiagnosticQuestion {
  id        String   @id @default(cuid())
  key       String   @unique
  dimension String
  order     Int      @default(0)
  locale    String   @default("en")
  prompt    Json
  options   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([dimension, order])
}

// A completed readiness self-assessment. Anonymous, so it is keyed by an opaque
// session id rather than a user.
model DiagnosticResult {
  id           String   @id @default(cuid())
  sessionId    String
  locale       String   @default("en")
  answers      Json
  overallScore Decimal
  band         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([sessionId])
}
